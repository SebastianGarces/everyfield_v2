{
  "name": "everyfield",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs');if(fs.existsSync('node_modules')&&fs.lstatSync('node_modules').isSymbolicLink()){console.error('node_modules is a symlink — install refused. pnpm has ALREADY rewired the checkout the symlink points into (lifecycle scripts run after linking): repair it there with CI=true pnpm install. Then remove this symlink and run a real pnpm install here. See AGENTS.md hard conventions.');process.exit(1)}\"",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file-if-exists=.env.local --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" \"ops/**/*.test.ts\" \"ops/**/*.test.mjs\"",
    "test:ci": "DATABASE_URL=postgresql://ci:ci@localhost:5432/ci RESEND_API_KEY=re_ci_placeholder tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" \"ops/**/*.test.ts\" \"ops/**/*.test.mjs\"",
    "test:live": "tsx --env-file-if-exists=.env.local ./scripts/live-db-run.ts",
    "evry:inventory": "tsx ops/evry/generate-inventory.ts",
    "evry:inventory:check": "tsx ops/evry/generate-inventory.ts --check",
    "evry:communication-inventory": "tsx ops/evry/generate-communication-inventory.ts",
    "evry:communication-inventory:check": "tsx ops/evry/generate-communication-inventory.ts --check",
    "evry:people-inventory": "tsx ops/evry/generate-people-inventory.ts",
    "evry:people-inventory:check": "tsx ops/evry/generate-people-inventory.ts --check",
    "evry:launch-inventory": "tsx ops/evry/generate-launch-inventory.ts",
    "evry:launch-inventory:check": "tsx ops/evry/generate-launch-inventory.ts --check",
    "evry:people-file-cleanup": "tsx --env-file-if-exists=.env.local scripts/evry-people-file-cleanup.ts",
    "evry:meetings-inventory": "tsx ops/evry/generate-meetings-inventory.ts",
    "evry:meetings-inventory:check": "tsx ops/evry/generate-meetings-inventory.ts --check",
    "evry:cost:audit": "node ops/evry-cost-audit.mjs",
    "evry:benchmark": "tsx --env-file-if-exists=.env.local scripts/evry-model-benchmark.ts",
    "evry:verify-selected-model": "node --no-warnings --experimental-test-module-mocks --import tsx --env-file-if-exists=.env.local src/app/api/evry/requests/selected-model-live-proof.ts",
    "evry:langfuse:smoke": "tsx ops/evry-langfuse-smoke.ts",
    "evry:latency:fixture": "tsx scripts/evry-latency-report.ts",
    "db:generate": "drizzle-kit generate && tsx scripts/restamp-migration.ts && prettier --write --log-level warn \"src/db/migrations/meta/*.json\"",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "pnpm exec tsx scripts/seed-dev-db.ts",
    "db:clean": "pnpm exec tsx scripts/seed-dev-db.ts --clean-only",
    "db:reset": "pnpm exec tsx scripts/seed-dev-db.ts",
    "g3:association": "tsx --env-file-if-exists=.env.local scripts/g3-association-lifecycle.ts",
    "g3:oversight": "tsx --env-file-if-exists=.env.local scripts/g3-oversight-model.ts",
    "g3:followups": "tsx --env-file-if-exists=.env.local scripts/g3-followup-generation.ts",
    "g3:feedback": "tsx --env-file-if-exists=.env.local scripts/g3-feedback-bridge.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.74",
    "@atlaskit/pragmatic-drag-and-drop": "^1.7.7",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.1.0",
    "@aws-sdk/client-s3": "^3.982.0",
    "@aws-sdk/s3-request-presigner": "^3.982.0",
    "@langfuse/otel": "5.11.0",
    "@langfuse/tracing": "5.11.0",
    "@mdx-js/mdx": "^3.1.1",
    "@neondatabase/serverless": "^1.0.2",
    "@node-rs/argon2": "^2.0.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.214.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
