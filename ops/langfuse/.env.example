# Generated values belong in ops/langfuse/.env. Run ./ops/langfuse/manage.sh init.
# Do not put model-provider credentials in this file or the local Langfuse stack.
LANGFUSE_WEB_HOST_PORT=3210
LANGFUSE_WORKER_HOST_PORT=3230
LANGFUSE_CLICKHOUSE_HTTP_HOST_PORT=3213
LANGFUSE_CLICKHOUSE_NATIVE_HOST_PORT=3300
LANGFUSE_MINIO_API_HOST_PORT=3290
LANGFUSE_MINIO_CONSOLE_HOST_PORT=3291
LANGFUSE_REDIS_HOST_PORT=3279
LANGFUSE_POSTGRES_HOST_PORT=3243

POSTGRES_PASSWORD=replace-with-random-hex
CLICKHOUSE_PASSWORD=replace-with-random-hex
MINIO_ROOT_PASSWORD=replace-with-random-hex
REDIS_AUTH=replace-with-random-hex
LANGFUSE_SALT=replace-with-random-hex
LANGFUSE_ENCRYPTION_KEY=replace-with-64-random-hex-characters
LANGFUSE_NEXTAUTH_SECRET=replace-with-random-hex

LANGFUSE_INIT_ORG_ID=everyfield-local
LANGFUSE_INIT_ORG_NAME=EveryField-local
LANGFUSE_INIT_PROJECT_ID=everyfield-local
LANGFUSE_INIT_PROJECT_NAME=EveryField-local
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-replace-with-random-hex
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-replace-with-random-hex
LANGFUSE_INIT_USER_EMAIL=langfuse-admin@everyfield.local
LANGFUSE_INIT_USER_NAME=EveryField-local-admin
LANGFUSE_INIT_USER_PASSWORD=replace-with-random-hex
