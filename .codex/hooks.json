{
  "description": "EveryField lifecycle hooks for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/ops/codex-session-context.sh\"",
            "timeout": 10,
            "statusMessage": "Loading engineering principles",
            "additionalContextLimit": 12000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/ops/guard-worktree-pnpm-hook.sh\"",
            "timeout": 10,
            "statusMessage": "Guarding node_modules"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/ops/format-agent-edit.sh\"",
            "timeout": 30,
            "statusMessage": "Formatting"
          }
        ]
      }
    ]
  }
}
