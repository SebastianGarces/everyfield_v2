# Database
DATABASE_URL=postgresql://user:password@localhost:5432/everyfield

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Phase Engine cron (Vercel Cron -> /api/phase-engine/assess)
# Required in prod. Vercel sends `Authorization: Bearer $CRON_SECRET` on cron
# invocations; the route rejects any request without it. Set this in the Vercel
# project env (Settings -> Environment Variables) AND locally for manual runs.
CRON_SECRET=

# Phase Engine pacing (#36). Optional. Bootstrap tokens-per-minute ceiling the
# assessment batch paces against before the first response states the real one;
# `x-ratelimit-limit-tokens` overrides it on every call, so set it only to skip
# the one slow run after an OpenAI tier upgrade. Default: 30000.
# PHASE_ENGINE_TPM_LIMIT=30000

# Storage (Tigris / S3-compatible)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
AWS_REGION=auto
AWS_BUCKET_NAME=your-bucket-name

# Notification unsubscribe links (F11 / N-007)
# Seals the capability token in every notification email's unsubscribe link
# (AES-256-GCM; see src/lib/notifications/channels/unsubscribe-token.ts).
#
# Generate with: openssl rand -base64 32
# That is ENFORCED, not advised: the code refuses anything under 32 characters
# (#263). The key is a single SHA-256 of this value, not a KDF, so one genuine
# token is an offline guessing oracle and a human-typed string does not survive
# it. `openssl rand -base64 32` gives 44 characters.
#
# REQUIRED IN PRODUCTION, with no substitute. CRON_SECRET is accepted as a
# fallback in local and test runs ONLY — one set of bytes must not guard both
# the scheduler's bearer token and every unsubscribe link in flight, and a
# leaked CRON_SECRET would otherwise let anyone forge opt-outs for six months.
# Without a usable value, composing a notification email FAILS rather than
# sending one with a dead opt-out link.
UNSUBSCRIBE_TOKEN_SECRET=

# Feedback → GitHub bridge (#190)
# Where the in-app feedback widget's email notification lands. Unset → no email.
FEEDBACK_EMAIL_TO=
#
# Every submission also opens an issue on the board so it enters the dispatch
# loop. Fine-grained PAT, `Issues: read and write` on THIS REPO ONLY — it needs
# nothing else, and the bridge never reads GitHub back.
# Unset → the bridge logs one line and skips; feedback still saves and emails.
GITHUB_FEEDBACK_TOKEN=
#
# Which board receives them. Optional; defaults to SebastianGarces/everyfield_v2.
# Point it at a scratch repo to exercise the bridge without touching the board.
# GITHUB_FEEDBACK_REPO=SebastianGarces/everyfield_v2

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx
EMAIL_FROM=EveryField <notifications@yourdomain.com>

# Vercel preview browser validation
# Preview deployments sit behind Vercel Authentication, so a browser (or agent)
# hitting one lands on vercel.com/login instead of the app. This secret is the
# sanctioned way past it: Vercel project Settings -> Deployment Protection ->
# Protection Bypass for Automation -> Add Secret, then paste it here.
# Used by `scripts/preview-url.sh --bypass`. See
# .claude/skills/browser-validation/SKILL.md.
# Local only — Vercel injects it into deployments automatically.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Sentry error tracking (optional — left unset, Sentry no-ops in local dev)
# Server-side DSN
SENTRY_DSN=
# Client-side DSN (exposed to the browser)
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload (build-time only; leave unset to skip uploads)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Self-hosted Langfuse server tracing. All four are required together; partial
# config is refused and never falls back to Langfuse Cloud. The secret is
# server-only and must never use a NEXT_PUBLIC_ prefix.
LANGFUSE_BASE_URL=http://127.0.0.1:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=local
